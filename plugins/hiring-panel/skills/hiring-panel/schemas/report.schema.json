{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/joshualarosa902-dev/hiring-panel/schemas/report.schema.json",
  "title": "Hiring Panel report (work/report.json)",
  "description": "Built ONLY by hp.report_build.build_report(run_dir); the model never writes report numbers. Rendered by hp.render.render_report into Hiring_Panel_Report.pdf (sections 1-5 on one Letter page), .md and .html (all ten sections). Contact details are masked everywhere. One number only: screening overall (a multiple of 5) next to 'Simulated screening check' and the method text. Never 'ATS score', per-reviewer numbers or probabilities.",
  "type": "object",
  "required": ["schema_version", "stage", "hp_version", "candidate", "target", "date", "mode", "general_review",
               "verdict_strip", "strong_resume", "closest_to_reject", "first_impression", "pinned_integrity",
               "weaknesses", "changes", "needs_you", "real_gaps", "panel", "screening", "truth_check"],
  "additionalProperties": false,
  "definitions": {
    "reviewer_id": { "enum": ["screening", "hiring_manager", "recruiter", "competitor", "ceo", "teammate", "skeptic"] },
    "verdict": { "enum": ["strong_no", "lean_no", "borderline", "lean_yes", "strong_yes"] },
    "advance": { "enum": ["yes", "no", "unsure"] },
    "band_value": {
      "type": "object",
      "required": ["value", "band"],
      "additionalProperties": false,
      "properties": {
        "value": { "type": ["integer", "null"], "minimum": 0, "maximum": 100, "multipleOf": 5, "description": "Kept for the record; the report prints only the band." },
        "band": { "type": "string" }
      }
    },
    "screening_side": {
      "type": "object",
      "required": ["overall", "band", "machine_readability", "keyword_match", "content_signals", "required"],
      "additionalProperties": false,
      "properties": {
        "overall": { "type": ["integer", "null"], "minimum": 0, "maximum": 100, "multipleOf": 5 },
        "band": { "type": "string" },
        "machine_readability": { "$ref": "#/definitions/band_value" },
        "keyword_match": { "$ref": "#/definitions/band_value" },
        "content_signals": { "$ref": "#/definitions/band_value" },
        "required": {
          "type": "object",
          "required": ["found", "total", "listed_only"],
          "additionalProperties": false,
          "properties": {
            "found": { "type": "integer", "minimum": 0 },
            "total": { "type": "integer", "minimum": 0 },
            "listed_only": { "type": "integer", "minimum": 0 },
            "label": { "enum": ["Required terms", "Job terms"], "description": "Job terms when the posting has no separate requirements list (keywords.coverage.basis all_terms); the counts then cover every job term." }
          }
        }
      }
    },
    "panel_row": {
      "type": "object",
      "required": ["id", "name", "verdict", "advance", "take"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/definitions/reviewer_id" },
        "name": { "type": "string" },
        "lens": { "type": "string", "maxLength": 60 },
        "verdict": { "$ref": "#/definitions/verdict" },
        "advance": { "$ref": "#/definitions/advance" },
        "take": { "type": "string", "maxLength": 200, "description": "one_line_take (<= 20 words)." }
      }
    }
  },
  "properties": {
    "schema_version": { "const": "1.0" },
    "stage": { "enum": ["panel", "final"], "description": "panel = delivered after synthesis, before the rewrite (statuses 'open', changes null)." },
    "hp_version": { "type": "string" },
    "candidate": { "type": "string", "description": "resume.json basics.name, else the screening's name only when it looks like a name, else '' (never a headline or role)." },
    "target": {
      "type": "object",
      "required": ["role"],
      "additionalProperties": false,
      "properties": { "role": { "type": "string" }, "company": { "type": ["string", "null"] } }
    },
    "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "mode": { "enum": ["parallel", "sequential", "lite", "manual"] },
    "general_review": { "type": "boolean" },
    "mode_note": { "type": "string", "description": "Approximate-independence disclosure; required in substance for sequential, lite and manual (the renderer adds a default when empty)." },
    "verdict_strip": {
      "type": "object",
      "required": ["vote_label", "screening_band", "mode_label"],
      "additionalProperties": false,
      "properties": {
        "vote_label": { "type": "string", "description": "e.g. '2 of 7 would move you forward' (counts advance == yes)." },
        "screening_band": { "type": "string" },
        "mode_label": { "type": "string" },
        "strong_line": { "type": "string", "description": "Fixed template, '' unless strong_resume: 'Strong resume. The <reviewer> came closest to saying no: <reason>. It still held because ...'" },
        "mixed_line": { "type": "string", "description": "Fixed template, '' unless the screening band is high (Ready to send or Close) while at most 3 of 7 reviewers would move the resume forward: 'The screening check reads the file and keywords; the panel reads the whole story.'" }
      }
    },
    "strong_resume": { "type": "boolean", "description": "True only when panel_vote.advance >= 5, no issue is critical or major, and nothing is pinned under 'Fix before you send'." },
    "closest_to_reject": {
      "type": ["object", "null"],
      "description": "From synthesis.closest_to_reject: the reviewer with the lowest verdict (ties in report order) and its top-ranked issue. Null for an empty panel.",
      "required": ["reviewer", "name", "verdict", "issue_id", "severity", "reason"],
      "additionalProperties": false,
      "properties": {
        "reviewer": { "$ref": "#/definitions/reviewer_id" },
        "name": { "type": "string" },
        "verdict": { "$ref": "#/definitions/verdict" },
        "issue_id": { "type": ["string", "null"] },
        "severity": { "enum": ["critical", "major", "moderate", "minor", null] },
        "reason": { "type": "string", "maxLength": 120, "description": "The issue's title, else the reviewer's one-line take." }
      }
    },
    "first_impression": { "type": ["string", "null"], "maxLength": 300, "description": "The Recruiter's 7-second takeaway (lens_data.seven_second_takeaway), at most 30 words, contact masked; null when missing. Shown under the verdict strip as 'What a recruiter sees in 7 seconds'." },
    "pinned_integrity": {
      "type": "array",
      "description": "Fix before you send.",
      "items": {
        "type": "object",
        "required": ["issue_id", "title", "fix"],
        "additionalProperties": false,
        "properties": { "issue_id": { "type": "string" }, "title": { "type": "string" }, "fix": { "type": "string" } }
      }
    },
    "weaknesses": {
      "type": "array",
      "description": "All ranked issues in synthesis order (never re-sorted); the PDF shows the top 5.",
      "items": {
        "type": "object",
        "required": ["rank", "issue_id", "title", "severity", "flagged_by", "flagged_count", "from_script", "status"],
        "additionalProperties": false,
        "properties": {
          "rank": { "type": "integer", "minimum": 1 },
          "issue_id": { "type": "string", "pattern": "^I[0-9]+$" },
          "title": { "type": "string" },
          "severity": { "enum": ["critical", "major", "moderate", "minor"] },
          "flagged_by": { "type": "array", "items": { "$ref": "#/definitions/reviewer_id" } },
          "flagged_count": { "type": "integer", "minimum": 0, "maximum": 7 },
          "from_script": { "type": "boolean" },
          "why": { "type": "string" },
          "evidence_quote": { "type": "string" },
          "status": { "enum": ["fixed", "improved", "needs_you", "gap", "open"], "description": "Final stage: resume.json meta.addressed (else the synthesis lane), checked for keyword issues against the re-read of the new resume; the lower of claim and re-check wins. fixed = every term now shown in real work (or a certification, diploma or language in its own section); improved = some progress but a term is only listed, marked as coursework or a class project, or still missing; needs_you / gap = no progress. Panel stage: always open." },
          "fix": { "type": "string" }
        }
      }
    },
    "changes": {
      "type": ["object", "null"],
      "required": ["bullets_rewritten", "reordered", "numbers_from_you", "cut"],
      "additionalProperties": false,
      "properties": {
        "bullets_rewritten": { "type": "integer", "minimum": 0 },
        "reordered": { "type": "boolean" },
        "numbers_from_you": { "type": "integer", "minimum": 0 },
        "cut": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["ref", "text", "reason"],
            "additionalProperties": false,
            "properties": { "ref": { "type": "string" }, "text": { "type": "string" }, "reason": { "type": "string" } }
          }
        }
      }
    },
    "needs_you": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["where", "ask"],
        "additionalProperties": false,
        "properties": { "where": { "type": "string" }, "ask": { "type": "string" } }
      }
    },
    "real_gaps": {
      "type": "array",
      "description": "Every issue a reviewer marked as a real gap (synthesis has_real_gap, else a real_gap fix), every issue meta.addressed marks gap and every keyword issue the re-check leaves as a gap. Empty only when no issue has a real-gap fix.",
      "items": {
        "type": "object",
        "required": ["title", "honest_route"],
        "additionalProperties": false,
        "properties": { "title": { "type": "string" }, "honest_route": { "type": "string" } }
      }
    },
    "panel": { "type": "array", "maxItems": 7, "items": { "$ref": "#/definitions/panel_row" } },
    "panel_after": {
      "type": ["object", "null"],
      "required": ["vote_label", "rows", "note"],
      "additionalProperties": false,
      "properties": {
        "vote_label": { "type": "string" },
        "rows": { "type": "array", "maxItems": 7, "items": { "$ref": "#/definitions/panel_row" } },
        "note": { "type": "string", "description": "Re-read by fresh reviewers; directional." }
      }
    },
    "screening": {
      "type": "object",
      "required": ["label", "method", "before", "after", "after_source", "precision_note", "disclaimer"],
      "additionalProperties": false,
      "properties": {
        "label": { "const": "Simulated screening check" },
        "method": { "type": "string" },
        "before": { "$ref": "#/definitions/screening_side" },
        "after": { "oneOf": [{ "$ref": "#/definitions/screening_side" }, { "type": "null" }] },
        "after_source": { "enum": ["docx", "pdf", null] },
        "precision_note": { "type": "string" },
        "disclaimer": { "type": "string" }
      }
    },
    "disagreements": {
      "type": "array",
      "maxItems": 2,
      "items": {
        "type": "object",
        "required": ["claim", "sides", "which_matters"],
        "additionalProperties": false,
        "properties": {
          "claim": { "type": "string" },
          "sides": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["reviewer", "view"],
              "additionalProperties": false,
              "properties": { "reviewer": { "$ref": "#/definitions/reviewer_id" }, "view": { "type": "string" }, "quote": { "type": "string" } }
            }
          },
          "which_matters": { "type": "string" }
        }
      }
    },
    "keyword_gaps": {
      "type": "array",
      "maxItems": 6,
      "description": "Final stage: from the re-read of the NEW resume, so a term it shows is never a gap. A missing term whose 'X or Y' alternative was found is left out.",
      "items": {
        "type": "object",
        "required": ["term", "status"],
        "additionalProperties": false,
        "properties": {
          "term": { "type": "string" },
          "status": { "enum": ["gap", "listed_only", "added_with_evidence"] },
          "note": { "type": "string" }
        }
      }
    },
    "strengths": {
      "type": "array",
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": ["title", "flagged_by", "underused"],
        "additionalProperties": false,
        "properties": {
          "title": { "type": "string" },
          "flagged_by": { "type": "array", "items": { "$ref": "#/definitions/reviewer_id" } },
          "underused": { "type": "boolean", "description": "Always false at the final stage (the advice was for the old resume)." }
        }
      }
    },
    "interview_prep": {
      "type": "array",
      "maxItems": 6,
      "items": {
        "type": "object",
        "required": ["question", "from"],
        "additionalProperties": false,
        "properties": { "question": { "type": "string" }, "from": { "enum": ["hiring_manager", "skeptic"] } }
      }
    },
    "knockouts": {
      "type": "array",
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": ["type", "jd_quote", "advice"],
        "additionalProperties": false,
        "properties": { "type": { "type": "string" }, "jd_quote": { "type": "string" }, "advice": { "type": "string" } }
      }
    },
    "truth_check": {
      "type": "object",
      "required": ["ran", "passed", "invented_facts", "bullets_traced", "bullets_total", "provenance"],
      "additionalProperties": false,
      "description": "'0 invented facts' is printed only when ran == 'script' and passed is true.",
      "properties": {
        "ran": { "enum": ["script", "model_only", "not_run"] },
        "passed": { "type": ["boolean", "null"] },
        "invented_facts": { "type": ["integer", "null"], "minimum": 0 },
        "bullets_traced": { "type": "integer", "minimum": 0 },
        "bullets_total": { "type": "integer", "minimum": 0 },
        "provenance": { "enum": ["subagent", "self", "unresolved", "not_run"] }
      }
    },
    "limitations": { "type": "array", "items": { "type": "string" } },
    "next_steps": { "type": "array", "maxItems": 4, "items": { "type": "string" } },
    "files": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "resume_docx": { "type": "string" }, "resume_pdf": { "type": "string" }, "resume_md": { "type": "string" },
        "report_pdf": { "type": "string" }, "report_md": { "type": "string" }, "report_html": { "type": "string" }
      }
    }
  }
}
